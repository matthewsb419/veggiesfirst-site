---
import "../styles.css";
import { SITE, NAME, APP_ID } from "../config";
import { guides } from "../guides";
const { title, description, path, ld, home = false, type = "website", noindex = false } = Astro.props;
const url = SITE + path;
const hasGuides = (await guides()).length > 0;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
<link rel="canonical" href={url}>
<meta property="og:site_name" content={NAME}>
<meta property="og:title" content={home ? NAME : title}>
<meta property="og:description" content={home ? "Stop doomscrolling. Do your to-dos first." : description}>
<meta property="og:type" content={type}>
<meta property="og:url" content={url}>
<meta property="og:image" content={SITE + "/img/og.jpg"}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={SITE + "/img/og.jpg"}>
{APP_ID && <meta name="apple-itunes-app" content={`app-id=${APP_ID}`}>}
{ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="icon" href="/favicon.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;800;900&display=swap">
</head>
<body>
<header class="wrap">
  <div class="brand">
    <a href="/" style="display:contents;color:inherit;text-decoration:none"><img src="/img/icon.png" alt="" width="44" height="44">Veggies First</a>
    <nav>
      <a class="hide" href="/#how">How it works</a>
      <a class="hide" href="/#plans">Plans</a>
      {hasGuides && <a href="/guides/">Guides</a>}
      <a href="/support.html">Support</a>
    </nav>
  </div>
</header>

<main>
<slot />
</main>

<footer class="wrap">
  <span>© 2026 Veggies First LLC</span>
  {hasGuides && <a href="/guides/">Guides</a>}
  <a href="/support.html">Support</a>
  <a href="/privacy.html">Privacy</a>
  <a href="https://www.apple.com/legal/internet-services/itunes/dev/stdeula/">Terms of use</a>
</footer>
</body>
</html>
