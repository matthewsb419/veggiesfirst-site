---
import Base from "../../layouts/Base.astro";
import GuideCards from "../../components/GuideCards.astro";
import DownloadCTA from "../../components/DownloadCTA.astro";
import { guides, TOPICS } from "../../guides";
const all = await guides();
const groups = Object.entries(TOPICS).map(([id, t]) => ({ id, ...t, list: all.filter((g) => g.data.topic === id) })).filter((g) => g.list.length);
---
<Base title="Guides · Veggies First" description="Practical how-tos on doomscrolling, Screen Time on iPhone, focus, habits and chores before screen time." path="/guides/" noindex={all.length === 0}>
  <div class="wrap" style="padding-block: 18px 30px">
    <p class="kicker">Guides</p>
    <h1>Get your time back.</h1>
    <p class="intro">Short, practical how-tos on screen time, focus and getting things done.</p>
    {groups.length === 0 && <p class="intro">The first guides are on their way.</p>}
    {groups.map((g) => (
      <section style="padding-block: 20px">
        <h2><a href={`/topics/${g.id}/`} style="color:inherit;text-decoration:none">{g.name}</a></h2>
        <p class="intro">{g.blurb}</p>
        <GuideCards guides={g.list} />
      </section>
    ))}
    <DownloadCTA />
  </div>
</Base>
